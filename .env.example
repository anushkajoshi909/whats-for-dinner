# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Required: OpenAI API key with access to GPT-4o and the embedding model below.
OPENAI_API_KEY=sk-replace-me

# Chat model used for the final recommendation reasoning step.
OPENAI_CHAT_MODEL=gpt-4o

# Embedding model used for both recipe ingestion and query embedding.
# text-embedding-3-small produces 1536-dim vectors (see EMBEDDING_DIMENSION below).
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Postgres/pgvector connection string, matches docker-compose.yml credentials.
DATABASE_URL=postgresql://pipeline:pipeline-pass@localhost:5432/challenge

# Where recipe .txt files live (see data/recipes).
RECIPE_DATA_PATH=data/recipes

# Number of candidate recipes retrieved from pgvector before GPT-4o reasoning.
RETRIEVAL_TOP_K=5
